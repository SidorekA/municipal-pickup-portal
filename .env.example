# ============================================================
# .env – Zmienne środowiskowe
# Skopiuj do .env i uzupełnij wartości. Nie commituj .env!
# ============================================================

# Django
SECRET_KEY=zmien-na-dlugi-losowy-klucz-min-50-znakow
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.development

# Baza danych
DB_NAME=waste_db
DB_USER=waste_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (środowisko produkcyjne)
EMAIL_HOST=mail.firma.local
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=system-odpadow@firma.local
ZGLOSZENIA_EMAIL=odbiory@firma-odbierajaca.local

# Pliki
STATIC_ROOT=/var/www/waste/static
MEDIA_ROOT=/var/www/waste/media

# Logi (produkcja)
LOG_FILE=/var/log/waste/error.log

# SSL (ustaw True jeśli środowisko używa HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
